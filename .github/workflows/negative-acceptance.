name: quorum-negative-acceptance

on:
  push:
    branches:
      - audit/negative-acceptance-20261108

jobs:
  negative-control:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - run: pip install -e '.[dev]'
      - name: Verify false repair is blocked
        run: quorum verify --config reviews/review.yaml --ledger reviews/negative_acceptance.md --no-incidents
